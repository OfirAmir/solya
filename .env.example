# Copy to .env.local. Never commit real values.
# openssl rand -base64 32

# Public origin, no trailing slash. Empty is fine locally.
APP_URL=
# Signs the customer cookie.
APP_SECRET=

# fixture runs the recorded 24 Nov sites with no SolarEdge account.
# live calls the Monitoring API.
SOLAREDGE_CLIENT=fixture
SOLAREDGE_CLIENT_ID=
SOLAREDGE_CLIENT_SECRET=
# Must match the redirect URI registered on the SolarEdge app.
SOLAREDGE_REDIRECT_URI=
SOLAREDGE_AUTHORIZE_URL=https://connect.solaredge.com/authorize
SOLAREDGE_TOKEN_URL=https://monitoringapi.solaredge.com/v2/oauth2/token
SOLAREDGE_API_BASE=https://monitoringapi.solaredge.com/v2
SOLAREDGE_SCOPES=SITE_DATA DEVICE_DATA
SOLAREDGE_ACCESS_DURATION=P24M
# Handover measured 14 idle days. Some later notes say 30. Do not treat either as permanent.
SOLYA_REFRESH_IDLE_DAYS=14

# AES-256-GCM key for per-site tokens. 32 bytes, base64.
TOKEN_ENCRYPTION_KEY=

# Neon connection string. Without it the process keeps an in-memory store.
DATABASE_URL=

# Section 5.5. Defaults are the closed or safe choices, not a guess of the open ones.
# Early pull is off. One daily pull per site.
SOLYA_DAILY_PULL=true
SOLYA_EARLY_PULL=false
SOLYA_EARLY_PULL_MAX_CREDITS_PER_SITE=1
# About $2 at $0.005 per credit. Faster polling is not decided.
SOLYA_MAX_CREDITS_PER_CUSTOMER_MONTH=400
SOLYA_SEND_WINDOW_HOURS=6
SOLYA_FALLBACK_SEND_HOUR=17
# Empty until a canonical domain is chosen. solyaa.ai and solyaa.co are both unset here.
SOLYA_CANONICAL_DOMAIN=
SOLYA_MARKETING_DOMAIN=
# Sol does not open service calls.
SOLYA_MAY_OPEN_SERVICE_CALLS=false
# Frozen v1 includes the weather term. A missing cloud reading is not invented.
SOLYA_RAY_INCLUDE_WEATHER=true
SOLYA_WEATHER_SOURCE=none
# unset | included | excluded. No rate is assumed.
SOLYA_VAT_MODE=unset
SOLYA_VAT_RATE=
# Only "stub" is implemented.
SOLYA_PAYMENT_PROVIDER=stub
# Starter-plan price used for the cost ceiling. Free tier spend is $0 until calls stop.
SOLYA_USD_PER_CREDIT=0.005

# Q&A stays on stored data unless this is true, a key, and a model are all set.
SOLYA_LLM_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SOLYA_LLM_MONTHLY_TOKEN_BUDGET=20000

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CRON_SECRET=
