# Copy to .env and fill in. Never commit .env.
SOLAREDGE_CLIENT_ID=
SOLAREDGE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
# Bot username without the @ (used for invite links)
TELEGRAM_BOT_USERNAME=
# Public HTTPS origin that reaches this service; the OAuth redirect is <this>/oauth/callback
PUBLIC_BASE_URL=https://solya.example.com
# Generate with: solya genkey
TOKEN_ENCRYPTION_KEY=
# Telegram chat ids that receive admin notices, as a JSON list, e.g. [123456789]
ADMIN_CHAT_IDS=[]
# Optional. Inside Docker the compose file sets this to /app/data/solya.db
# DATABASE_URL=sqlite:///./data/solya.db

# --- Web onboarding (all optional) ---
# Defaults to an HMAC of TOKEN_ENCRYPTION_KEY when unset
# SESSION_SECRET=
# /admin returns 404 while unset
# ADMIN_PASSWORD=
# JSON list of reverse-proxy IPs whose X-Forwarded-For is trusted
# TRUSTED_PROXIES=["127.0.0.1"]
# Open-ended AI answers (off by default)
# LLM_ENABLED=false
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_MONTHLY_TOKENS_PER_OWNER=50000
